# Deployment script configuration. Fill required addresses for the selected chain.
# Foundry reads this file as .env. Shell arguments require exported variables.
CHAIN_NAME=sepolia
API_KEY_ALCHEMY=
API_KEY_ETHERSCAN=
FOUNDRY_PROFILE=default

# Required existing OSx contracts and initial authorities.
PLUGIN_REPO_FACTORY=
DAO_FACTORY=
ADMIN_REPO=
ADMIN_OWNER=
PLUGIN_MAINTAINER=

# Optional names; the script generates defaults when these variables are absent.
# PLUGIN_NAME=
# DAO_NAME=
# DAO_URI=

# Strategy fee: 100 basis points = 1%; maximum 1000 = 10%.
FEE_RECIPIENT=0x0000000000000000000000000000000000000000
FEE_BASIS_POINTS=0

# Makefile broadcast targets also read PRIVATE_KEY.
# Direct Forge commands can use a keystore account instead; see:
# https://github.com/aragon/protocol-doc/blob/main/deployment/capital-distributor.md
