# =============================================================================
# Deployment Configuration (customize these for your deployment)
# =============================================================================

# Required: Address that will control the Admin plugin and receive DAO admin rights
DAO_ADMIN=0xYourAdminAddress

# Required: Address that can maintain the CDP plugin repo (update versions, etc.)
PLUGIN_MAINTAINER=0xYourMaintainerAddress

# Optional: DAO subdomain (default: "cdp-{timestamp}")
# DAO_NAME=my-cdp-dao

# Optional: DAO metadata URI (default: "ipfs://cdp")
# DAO_URI=ipfs://QmYourMetadataHash

# Optional: Plugin repo subdomain (default: "cdp-plugin-{timestamp}")
# PLUGIN_NAME=my-cdp-plugin

# Optional: Protocol fee recipient (default: address(0) = no fees)
# FEE_RECIPIENT=0xYourFeeRecipient

# Optional: Protocol fee in basis points (default: 0)
# FEE_BASIS_POINTS=100

# Optional: Encoder type - "vault" or "ve" (default: "vault")
# ENCODER_TYPE=vault

# Optional: VotingEscrow address for condition config (only needed if using VE encoder)
# VOTING_ESCROW=0xYourVotingEscrowAddress

# Optional: Token address for condition config (required if VOTING_ESCROW is set)
# TOKEN=0xYourTokenAddress

# =============================================================================
# RPC URLs
# =============================================================================

KATANA_RPC_URL=https://your-katana-rpc-url

# Chain name for fork selection (used by Base.s.sol broadcast modifier)
CHAIN_NAME=katana
